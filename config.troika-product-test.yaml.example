# Isolated local/closed-beta profile for testing Troika without paid inference.
# Copy this file to <HERMES_HOME>/config.yaml and store OPENROUTER_API_KEY only
# in <HERMES_HOME>/.env. Never commit the real key.

model:
  default: openrouter/free
  provider: openrouter
  base_url: https://openrouter.ai/api/v1

# Keep the product boundary explicit. The authenticated product API also
# enforces this toolset server-side, even if an operator changes the config.
toolsets:
  - troika-product
platform_toolsets:
  api_server:
    - troika-product

platforms:
  api_server:
    enabled: true
    extra:
      # Server-side kill switch; no APK release is needed to disable voice.
      product_voice_enabled: true
      # Separate default-off screen capability. The second flag explicitly
      # allows one reduced frame to leave the phone for the vision provider.
      product_screen_snapshot_enabled: false
      product_screen_external_vision_enabled: false
      # Private loopback/container worker. Clients never choose this address.
      product_stt_url: http://127.0.0.1:8766

agent:
  max_turns: 90
  tool_use_enforcement: true
  api_max_retries: 3

stt:
  enabled: true
  provider: groq

openrouter:
  response_cache: true
  response_cache_ttl: 300
