# Тройка — конфигурация окружения
# Скопируй в .env и заполни ключи:  cp .env.troika.example .env
#
# ОБЯЗАТЕЛЬНЫЕ ключи отмечены ★
# Всё остальное — опционально

# =============================================================================
# ★ ОСНОВНОЙ LLM — Anthropic Claude
# =============================================================================
# Главный мозг Тройки + claude-code кодер
# Получить: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Модель по умолчанию (можно переопределить в config.yaml)
# Вариант подешевле: anthropic/claude-sonnet-4-6
# LLM_MODEL=anthropic/claude-opus-4.6

# =============================================================================
# ★ ГОЛОСОВОЙ ВВОД — Groq STT
# =============================================================================
# Whisper через Groq — бесплатно, 0.8 секунды вместо 30 на локальном CPU
# Получить бесплатно: https://console.groq.com/keys
GROQ_API_KEY=

# STT через Groq (не менять — оптимально для сервера)
STT_BACKEND=groq

# =============================================================================
# ★ ДОСТУП ПРИЛОЖЕНИЯ — пароль API-сервера
# =============================================================================
# Этот же ключ вводишь в приложении (Настройки → API ключ).
# Сервер слушает 0.0.0.0 и откажется стартовать, пока здесь шаблон.
# Сгенерируй уникальный ключ: openssl rand -hex 32
API_SERVER_KEY=your_api_key_here

# API-сервер включён, слушает наружу — это задано в docker-compose.troika.yml
# (API_SERVER_ENABLED=true, API_SERVER_HOST=0.0.0.0, API_SERVER_PORT=8642).
# Менять тут не нужно.

# =============================================================================
# ★ ЗАКРЫТАЯ BETA — индивидуальные токены устройств вместо общего ключа
# =============================================================================
# Для подписочного сервиса включи этот режим. Токены выдаются оператором через
# `python -m troika_product ... provision`; инструкция в docs/TROIKA_CLOSED_BETA_SETUP.md.
TROIKA_PRODUCT_AUTH_ENABLED=true
TROIKA_PRODUCT_AUTH_DB=/opt/data/troika_access.db
# Пока продукт тестируется без тарифных ограничений. Счётчик и схема готовы,
# но сервер не отклоняет запросы по дневной квоте.
TROIKA_PRODUCT_QUOTAS_ENABLED=false
# Личные DOCX/PDF/PPTX. Внутри только opaque-имена; доступ проверяется по token.
TROIKA_PRODUCT_ARTIFACT_ROOT=/opt/data/troika_artifacts
# Exact coordinates never leave product server unless operator separately
# enables this integration after consent and privacy review.
TROIKA_EXTERNAL_GEOCODING_ENABLED=false

# =============================================================================
# ПРОВАЙДЕРЫ LLM — «мозг» Тройки (опционально, раскомментируй нужные)
# =============================================================================
# Тройка может думать любой из этих моделей. Раскомментируй строку (убери #)
# и вставь ключ. Какую модель использовать — задаётся в config.yaml / голосом
# («переключись на gpt-4o»). ANTHROPIC выше — основной, остальные — выбор.

# --- OpenRouter — один ключ, сотни моделей (GPT, Gemini, Llama, DeepSeek…) ---
# Самый гибкий: не нужны отдельные ключи провайдеров. https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- OpenAI — GPT-4o, o1, o3 напрямую ---
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini — Gemini 2.5/3 Pro и Flash (дёшево, большой контекст) ---
# https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- xAI Grok ---
# https://console.x.ai
# XAI_API_KEY=

# --- DeepSeek — дёшево, сильный в коде и рассуждениях ---
# https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=

# --- Mistral ---
# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# --- Groq как LLM — мгновенный инференс Llama/Mixtral ---
# Ключ GROQ_API_KEY уже задан выше (для голоса), он же работает как LLM.

# --- Z.ai / GLM (Zhipu) ---
# https://z.ai
# ZAI_API_KEY=
# GLM_API_KEY=

# --- Kimi (Moonshot) — огромный контекст ---
# https://platform.moonshot.ai
# KIMI_API_KEY=

# --- MiniMax ---
# https://www.minimax.io
# MINIMAX_API_KEY=

# --- Qwen / DashScope (Alibaba) — для qwen-code кодера ---
# https://dashscope.console.aliyun.com
# DASHSCOPE_API_KEY=

# --- NVIDIA NIM ---
# https://build.nvidia.com
# NVIDIA_API_KEY=

# --- Ollama — локальные модели на самом сервере (без внешних ключей) ---
# Нужен запущенный ollama; укажи адрес если не на localhost.
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# МЕССЕНДЖЕРЫ (опционально — выбери нужные)
# =============================================================================

# Telegram бот (команды голосом через Telegram)
# 1. Создай бота через @BotFather
# 2. Узнай свой Telegram ID: @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=ВАШ_TELEGRAM_ID

# =============================================================================
# БРАУЗЕР И ВЕБ
# =============================================================================
# Браузерные задачи (опционально)
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# =============================================================================
# ТЕРМИНАЛ И КОДИНГ
# =============================================================================
# Рабочий каталог кодеров внутри контейнера
TERMINAL_CWD=/opt/data/workspaces

# Таймаут выполнения команд (секунды)
TERMINAL_TIMEOUT=120

# =============================================================================
# DEBUG (выключено по умолчанию)
# =============================================================================
WEB_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false
